# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Storefront URL - set on production for correct canonical URLs and OG images
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Channel slug (required) - your Saleor channel identifier
# The root "/" redirects to this channel (e.g., "/default-channel")
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Saleor app token (required for checkout) - needs HANDLE_PAYMENTS.
# Used server-side only by the Razorpay webhook and checkout finalize routes.
# Never expose it to the browser (do not prefix it with NEXT_PUBLIC_).
SALEOR_APP_TOKEN=

# Razorpay webhook signing secret (required). Must match the secret configured on
# the webhook in the Razorpay dashboard for the same mode (test or live).
RAZORPAY_WEBHOOK_SECRET=

# RRWeb Session Recording Endpoint
NEXT_PUBLIC_RRWEB_API_URL=http://localhost:8082/events
